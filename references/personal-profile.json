{
  "profile_version": "0.3.0",
  "owner": "personal",
  "discipline": [
    "structural engineering",
    "earthquake engineering",
    "seismic resilience",
    "self-centering systems",
    "rocking systems"
  ],
  "default_mode": "deep",
  "report_language": "zh-CN",
  "manuscript_language": "en-US",
  "document_types": ["journal article", "conference paper", "thesis chapter"],
  "source_priority": ["tex", "docx", "pdf", "md", "txt"],
  "preserve_source": true,
  "privacy": {
    "allow_bibliographic_metadata_queries": true,
    "allow_fulltext_external_upload": false,
    "allow_figure_external_upload": false,
    "crossref_mailto": ""
  },
  "claim_support": {
    "default_scope": "priority",
    "evidence_top_k": 5,
    "require_fulltext_for_support": true,
    "allow_open_access_download": false,
    "formal_finding_min_confidence": 0.8
  },
  "quantitative": {
    "enabled": true,
    "relative_tolerance": 0.01,
    "percentage_point_tolerance": 0.2,
    "compare_sections": ["Abstract", "Results", "Discussion", "Conclusion", "Conclusions"]
  },
  "standards": {
    "default_mode": "metadata-only",
    "require_rights_attestation": true,
    "fulltext_external_upload": false
  },
  "tense": {
    "completed_study_actions": "past",
    "general_conclusions": "present",
    "proposed_model_performance": "present"
  },
  "abbreviations": {
    "minimum_uses_after_definition": 2,
    "require_definition_in_abstract_and_main_text": true,
    "require_abbreviation_after_definition": true,
    "whitelist": ["ASCE", "DOI", "ISO", "SI", "Hz", "MPa", "GPa", "kN"]
  },
  "style": {
    "english_variant": "en-US",
    "prefer_figure_token": "Fig.",
    "prefer_equation_token": "Eq.",
    "space_between_number_and_si_unit": true,
    "space_before_percent": false,
    "avoid_title_abbreviations": true
  },
  "checks": {
    "unused_bibliography_entries": true,
    "unused_latex_labels": true,
    "redefined_symbols": "needs-review",
    "hardcoded_latex_cross_references": true
  },
  "journal_priority": [
    "Earthquake Engineering & Structural Dynamics",
    "Engineering Structures",
    "ASCE Journal of Structural Engineering"
  ],
  "severity_overrides": {}
}
